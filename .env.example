# Copy to `.env` and fill in values:
#   cp .env.example .env

# NextAuth — generate with: npx auth secret
AUTH_SECRET="replace-with-a-long-random-string"

# Admin dashboard password (Credentials provider).
# If unset, the app falls back to: imran-admin
ADMIN_PASSWORD="imran-admin"

# PostgreSQL connection string
# Docker Compose (recommended):
#   docker compose up -d
#   DATABASE_URL="postgresql://postgres:password@127.0.0.1:5432/imran_portfolio"
#
# Or a local Postgres install with the same credentials/db name.
DATABASE_URL="postgresql://postgres:password@127.0.0.1:5432/imran_portfolio"
